# Copy this file to .env and fill in the values. Never commit .env.

# Required: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model names: see https://ai.google.dev/gemini-api/docs/models for the current list
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the primary model's quota runs out (each model has its own quota)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=60
# Trust the OS certificate store (needed behind corporate TLS-inspecting proxies)
USE_OS_TRUST_STORE=true

# development | staging | production  (production disables /docs)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Shown to employees in answers and fallback messages
COMPANY_NAME=Acme Corp
HR_CONTACT_EMAIL=hr@example.com

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Abuse protection
RATE_LIMIT=20/minute
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_MESSAGES=20
# For multiple backend replicas, share limits via Redis:
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Retrieval tuning
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35
